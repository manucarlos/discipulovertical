# Copie este arquivo para .env.local e preencha. NUNCA envie o .env.local ao GitHub
# nem cole estes valores em chats (veja docs/RUNBOOK.md).

# Supabase: painel do projeto > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço público do site (sem barra no fim), usado nos links dos e-mails de lembrete.
NEXT_PUBLIC_SITE_URL=

# Lembretes por e-mail (opcional; só quando for ligar o recurso). Veja docs/CONTAS.md.
# CRON_SECRET: um texto longo e aleatório (32+ caracteres) que só o site e o agendador conhecem.
CRON_SECRET=
RESEND_API_KEY=
# Ex.: "Vertical Church <discipulado@seudominio.org.br>" (o domínio precisa estar verificado no Resend)
EMAIL_FROM=
